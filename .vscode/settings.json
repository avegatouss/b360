{
  "//---": "Éditeur — uniformité totale entre toi, Claude Code et Codex",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [120],
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,

  "//---files": "Fichiers — nettoyage automatique",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/vendor": true,
    "**/node_modules": true,
    "**/storage/framework/cache": true,
    "**/storage/framework/sessions": true,
    "**/storage/framework/views": true,
    "**/storage/logs/*.log": true,
    "**/bootstrap/cache/*.php": true,
    "**/.phpunit.result.cache": true,
    "**/.phpunit.cache": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/storage/framework/**": true,
    "**/storage/logs/**": true,
    "**/.git/objects/**": true
  },
  "files.associations": {
    "*.blade.php": "blade",
    "*.env.*": "dotenv",
    ".env*": "dotenv",
    "module.json": "jsonc",
    "composer.json": "jsonc",
    "deptrac.yaml": "yaml",
    "phpstan.neon": "neon"
  },

  "//---php": "PHP / Laravel — Intelephense + Pint + PHPStan",
  "php.suggest.basic": false,
  "php.validate.enable": false,
  "intelephense.environment.phpVersion": "8.2.0",
  "intelephense.files.maxSize": 5000000,
  "intelephense.diagnostics.embeddedLanguages": false,
  "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": false,
  "intelephense.format.enable": false,
  "intelephense.environment.includePaths": [
    "vendor/laravel/framework/src",
    "vendor/nwidart/laravel-modules/src",
    "Modules"
  ],
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "calendar",
    "Core",
    "ctype",
    "curl",
    "date",
    "dom",
    "exif",
    "fileinfo",
    "filter",
    "ftp",
    "gd",
    "hash",
    "iconv",
    "intl",
    "json",
    "ldap",
    "libxml",
    "mbstring",
    "mcrypt",
    "memcached",
    "mysqli",
    "openssl",
    "pcntl",
    "pcre",
    "PDO",
    "pdo_mysql",
    "Phar",
    "posix",
    "readline",
    "redis",
    "session",
    "soap",
    "sockets",
    "sodium",
    "SPL",
    "sqlite3",
    "standard",
    "superglobals",
    "tokenizer",
    "xml",
    "xmlreader",
    "xmlwriter",
    "yaml",
    "zip",
    "zlib",
    "wordpress-stubs",
    "imagick"
  ],

  "//---formatters": "Formatters par langage",
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "[blade]": {
    "editor.defaultFormatter": "onecentlin.laravel-blade",
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  "//---pint": "Laravel Pint",
  "laravel-pint.enable": true,
  "laravel-pint.executablePath": "vendor/bin/pint",
  "laravel-pint.configPath": "pint.json",

  "//---phpstan": "PHPStan",
  "phpstan.binPath": "vendor/bin/phpstan",
  "phpstan.configFile": "phpstan.neon",
  "phpstan.enabled": true,
  "phpstan.memoryLimit": "1G",

  "//---blade": "Blade",
  "blade.format.enable": true,
  "bladeFormatter.format.indentSize": 4,
  "bladeFormatter.format.wrapLineLength": 120,
  "bladeFormatter.format.wrapAttributes": "auto",

  "//---laravel": "Laravel intellisense",
  "LaravelExtraIntellisense.basePath": ".",
  "LaravelExtraIntellisense.basePathForCode": ".",
  "LaravelExtraIntellisense.modelsPaths": ["app", "Modules"],

  "//---git": "Git — discipline",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": false,
  "git.suggestSmartCommit": false,
  "git.fetchOnPull": true,
  "git.pruneOnFetch": true,
  "git.branchProtection": ["main", "develop"],
  "git.branchProtectionPrompt": "alwaysCommitToNewBranch",
  "git.allowForcePush": false,
  "git.confirmForcePush": true,
  "git.inputValidation": true,
  "git.inputValidationLength": 72,
  "git.inputValidationSubjectLength": 72,

  "//---gitlens": "GitLens",
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.statusBar.enabled": true,

  "//---github-pr": "GitHub PR",
  "githubPullRequests.pullBranch": "always",
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.fileListLayout": "tree",

  "//---conventional": "Conventional Commits",
  "conventionalCommits.scopes": [
    "core",
    "auth",
    "users",
    "instances",
    "settings",
    "billing",
    "dashboard",
    "lang",
    "currency",
    "modulemanager",
    "installer",
    "demo",
    "eshop360",
    "catalog",
    "pricing",
    "inventory",
    "sales",
    "purchase",
    "invoicing",
    "finance",
    "crm",
    "channel",
    "reporting",
    "hr",
    "projects",
    "communication",
    "platform",
    "tenancy",
    "iam",
    "feature-control",
    "observability",
    "workflow",
    "integration-hub",
    "file-center",
    "shared-kernel",
    "ui-kit",
    "api",
    "deps",
    "ci",
    "docs",
    "governance",
    "security",
    "perf",
    "tests",
    "infra"
  ],
  "conventionalCommits.silentAutoCommit": false,
  "conventionalCommits.gitmoji": false,
  "conventionalCommits.lineBreak": "\\n",
  "conventionalCommits.promptScopes": true,
  "conventionalCommits.promptBody": true,
  "conventionalCommits.promptFooter": true,

  "//---spell": "Anti-typos en français + technique",
  "cSpell.language": "en,fr",
  "cSpell.enabled": true,
  "cSpell.enabledLanguageIds": [
    "php",
    "blade",
    "javascript",
    "typescript",
    "markdown",
    "yaml",
    "json",
    "jsonc"
  ],
  "cSpell.words": [
    "Anthropic",
    "Codex",
    "Eshop",
    "Eshop360",
    "InventoryX",
    "Menuiserie",
    "Codifarm",
    "B360",
    "tenancy",
    "multitenant",
    "lockforupdate",
    "deptrac",
    "intelephense",
    "Larastan",
    "Pint",
    "Pest",
    "Spatie",
    "nwidart",
    "Tabler",
    "Blade",
    "Laravel",
    "Eloquent",
    "RBAC",
    "ABAC",
    "PHPStan",
    "Rector",
    "phpinsights",
    "lockscreen",
    "InetPay",
    "Saphir",
    "wholesale",
    "pharmacy",
    "pght",
    "POS",
    "facturation",
    "fournisseurs",
    "remboursement",
    "revendeur",
    "Webhook",
    "subdomain",
    "lockfile",
    "outbox",
    "idempotence"
  ],

  "//---todo": "TODO Tree",
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "BUG",
    "HACK",
    "XXX",
    "NOTE",
    "DOIT",
    "À-FAIRE",
    "B360-TODO",
    "B360-FIXME"
  ],
  "todo-tree.highlights.customHighlight": {
    "B360-TODO": {
      "background": "#1565c0",
      "foreground": "#ffffff",
      "icon": "rocket"
    },
    "B360-FIXME": {
      "background": "#c62828",
      "foreground": "#ffffff",
      "icon": "alert"
    }
  },

  "//---search": "Recherche",
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/bootstrap/cache": true,
    "**/.phpunit.result.cache": true,
    "**/public/build": true,
    "**/public/hot": true,
    "**/dist": true
  },

  "//---terminal": "Terminal — meilleurs raccourcis",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.fontFamily": "MesloLGS NF, Fira Code, monospace",

  "//---workbench": "Workbench",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 12,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.tree.indent": 16,

  "//---explorer": "Explorer — regroupe les fichiers liés",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.php": "${capture}.spec.php, ${capture}Test.php",
    "composer.json": "composer.lock, .php-cs-fixer.cache, .phpunit.result.cache, phpunit.xml*, phpstan.neon*, deptrac.yaml, pint.json, rector.php",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .nvmrc, .npmrc, vite.config.*, tailwind.config.*, postcss.config.*",
    ".env": ".env.*, .env.example",
    "README.md": "README_PACK.md, INSTALL.md, CONTRIBUTING.md, ARCHITECTURE.md, ROADMAP_REBUILD.md, CLAUDE.md, CODEX.md, AGENTS.md, PROJECT_STATUS.md, CHANGELOG_ARCHITECTURAL.md, QUALITY_GATE.md, MODULE_BLUEPRINT.md, PROMPTS.md"
  },

  "//---claude": "Claude Code — réglages",
  "claude.autoApprove": false,
  "claude.contextFiles": [
    "CLAUDE.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "docs/context/PROJECT_DIGEST.md",
    "docs/memory/CURRENT_STATE.md",
    "docs/governance/PROTECTED_AREAS.md"
  ],

  "//---codex": "Codex — réglages",
  "codex.autoApprove": false,
  "codex.contextFiles": [
    "CODEX.md",
    "AGENTS.md",
    "docs/context/PROJECT_DIGEST.md",
    "docs/memory/CURRENT_STATE.md"
  ],

  "//---inspector": "Sécurité workspace",
  "security.workspace.trust.untrustedFiles": "prompt",
  "security.workspace.trust.banner": "always",
  "security.workspace.trust.startupPrompt": "always"
}
