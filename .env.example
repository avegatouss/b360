#############################################
# Application
#############################################

APP_NAME=B360
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://b360.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en       # Langue de secours
APP_FAKER_LOCALE=fr_FR       # Locale pour Faker (factories/seeders)

APP_PERSONAS_DEFAULT_COUNTRY_CODE=225  # Code pays par défaut (ex. Côte d'Ivoire)

BCRYPT_ROUNDS=12             # Coût bcrypt (12 recommandé)


#############################################
# Journalisation (Logs)
#############################################

LOG_CHANNEL=stack            # Canal principal (stack = empile plusieurs drivers)
LOG_STACK=single             # Stack actuel : "single"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug              # Niveau de log minimum
LOG_PERMISSIONS=true         # Log des permissions (app custom)

# Sentry/Telescope
SENTRY_LARAVEL_DSN=null      # DSN Sentry (null pour désactiver)
TELESCOPE_ENABLED=true       # Telescope activé (à désactiver en prod)

#############################################
# Sécurité & Authentification
#############################################

HMAC_TOLERANCE_SECONDS=300   # Tolérance de vérif HMAC (secondes)
AUTH_GUARD=web               # Garde d'auth par défaut
AUTH_PASSWORD_BROKER=users   # Broker de réinitialisation


#############################################
# Base de données (MySQL - app)
#############################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b360
DB_USERNAME=root
DB_PASSWORD=""

#############################################
# Sessions
#############################################

SESSION_DRIVER=database      # Stockage sessions (database conseillé)
SESSION_LIFETIME=120         # Durée (minutes)
SESSION_ENCRYPT=false        # Chiffrement du payload de session
SESSION_PATH=/
SESSION_DOMAIN=null

#############################################
# Caches & Filesystems & Queue
#############################################

CACHE_STORE=database         # Store principal du cache
CACHE_PREFIX=                # Préfixe des clés de cache

FILESYSTEM_DISK=local        # Disque par défaut
QUEUE_CONNECTION=database    # File d'attente via DB

#############################################
# Redis (si utilisé)
#############################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#############################################
# E-mails
#############################################

MAIL_MAILER=smtp
MAIL_HOST=mail.exceliam.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

#############################################
# AWS (placeholder si non utilisé)
#############################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#############################################
# Application installée ou non
#############################################
APP_INSTALLED=false
INSTANCE_MODE=single
INSTANCE_RESOLUTION=subdomain
INSTANCE_DB_STRATEGY=shared
DB_PREFIX=""
DB_SUFFIX=""

#############################################
# Frontend (Vite)
#############################################

VITE_APP_NAME="${APP_NAME}"

#############################################
# Notifications Push Web (VAPID)
#############################################

# Clés publiques/privées VAPID (ne pas exposer)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

#############################################
# Diffusion / Broadcasting
#############################################

BROADCAST_CONNECTION=log     # Diffusion via log (pas de driver temps réel)
