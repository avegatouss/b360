## tools/phpstan/phpstan.neon
## Analyse statique B360 — niveau 6 + Larastan + règles custom anti-couplage

includes:
    - vendor/larastan/larastan/extension.neon
    - tools/phpstan/baseline.neon

parameters:
    level: 6

    paths:
        - app
        - Modules
        - bootstrap
        - config
        - database/seeders

    excludePaths:
        analyseAndScan:
            - vendor/*
            - storage/*
            - bootstrap/cache/*
            - public/*
            - node_modules/*
            - Modules/*/Database/Migrations/*
            - Modules/InventoryX/*
            # Fichiers référençant des traits non installés (MediaLibrary)
            - app/Models/Personne.php
            - app/Models/PersonneMorale.php
            - app/Models/PersonnePhysique.php
            # Livewire non installé
            - app/Livewire/*

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    checkModelProperties: true

    ## Détection ciblée
    universalObjectCratesClasses:
        - Illuminate\Http\Request
        - Illuminate\Support\Fluent

    noUnnecessaryCollectionCall: false

    ## Ignore patterns standards Laravel/Eloquent
    ignoreErrors:
        # Eloquent magie (méthodes dynamiques)
        - '#Call to an undefined method [a-zA-Z\\_]+::scope[a-zA-Z]+\(\)#'
        # Macros Laravel
        - '#Call to an undefined method [a-zA-Z\\_]+::macro\(\)#'
        # Spatie Permission teams
        - '#Call to an undefined static method Spatie\\Permission\\Models\\(Role|Permission)::setPermissionsTeamId\(\)#'
        # Laravel Modules helper
        - '#Call to an undefined method Nwidart\\Modules\\.+#'
        # Tinker
        -
            message: '#Variable \$this might not be defined#'
            paths:
                - bootstrap/*

    ## Bootstrap pour autoloading
    bootstrapFiles:
        - vendor/autoload.php

    ## Niveau strict supplémentaire (à activer progressivement)
    # strictRules:
    #     allRules: true
    #     disallowedConstructs: true
    #     disallowedShortTernary: true
    #     numericOperandsInArithmeticOperators: true
    #     uselessCast: true
    #     overwriteVariablesWithLoop: true

