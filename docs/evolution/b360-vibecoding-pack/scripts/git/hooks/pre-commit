#!/usr/bin/env bash
# .git/hooks/pre-commit
# Lint + analyse statique sur les fichiers PHP stagés uniquement.
# Rapide (3-15s sur un commit moyen).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Bypass si on est en plein rebase / cherry-pick / merge
if [ -d ".git/rebase-merge" ] || [ -d ".git/rebase-apply" ] || \
   [ -f ".git/MERGE_HEAD" ] || [ -f ".git/CHERRY_PICK_HEAD" ]; then
    exit 0
fi

# Récupérer les fichiers PHP stagés
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|blade\.php)$' || true)

if [ -z "$STAGED_PHP" ]; then
    exit 0
fi

echo -e "${GREEN}[pre-commit]${NC} Vérification de $(echo "$STAGED_PHP" | wc -l | tr -d ' ') fichier(s) PHP stagé(s)..."

# 1. Pint (format) — sur les fichiers stagés uniquement
if [ -x "vendor/bin/pint" ]; then
    echo -e "${GREEN}[pre-commit]${NC} Pint (format)..."
    if ! echo "$STAGED_PHP" | xargs vendor/bin/pint --test 2>&1 | tail -20; then
        echo ""
        echo -e "${RED}╔════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${RED}║  ✗ Pint a détecté des problèmes de formatage                  ║${NC}"
        echo -e "${RED}╚════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo "Pour corriger automatiquement :"
        echo -e "  ${YELLOW}vendor/bin/pint${NC}"
        echo "  git add -u && git commit"
        echo ""
        echo "Ou bypass d'urgence : git commit --no-verify"
        exit 1
    fi
fi

# 2. PHPStan — sur les fichiers stagés uniquement
if [ -x "vendor/bin/phpstan" ] && [ -f "phpstan.neon" ]; then
    echo -e "${GREEN}[pre-commit]${NC} PHPStan..."
    if ! echo "$STAGED_PHP" | xargs vendor/bin/phpstan analyse --memory-limit=1G --no-progress 2>&1 | tail -30; then
        echo ""
        echo -e "${RED}✗ PHPStan a détecté des erreurs.${NC}"
        echo ""
        echo "Vérifie les erreurs ci-dessus. Pour bypasser : git commit --no-verify"
        exit 1
    fi
fi

# 3. Vérifier qu'aucune variable dump n'est laissée
if echo "$STAGED_PHP" | xargs grep -nE '\b(dd|dump|var_dump|print_r|ray)\(' 2>/dev/null | grep -v '//.*\(dd\|dump\|var_dump\)'; then
    echo ""
    echo -e "${RED}✗ Appels de debug détectés (dd, dump, var_dump, print_r, ray).${NC}"
    echo "Retire-les avant de committer (ou commente-les)."
    exit 1
fi

# 4. Vérifier qu'aucun TODO B360-FIXME n'est introduit sans ticket
TODOS_INTRODUCED=$(echo "$STAGED_PHP" | xargs grep -nE 'B360-FIXME' 2>/dev/null || true)
if [ -n "$TODOS_INTRODUCED" ]; then
    echo -e "${YELLOW}⚠ B360-FIXME détectés dans tes changements :${NC}"
    echo "$TODOS_INTRODUCED"
    echo ""
    echo "Documente le risque dans docs/memory/OPEN_RISKS.md ou supprime le marqueur."
fi

# 5. Vérifier les zones protégées
if [ -f "scripts/quality/check-protected-areas.sh" ]; then
    if ! bash scripts/quality/check-protected-areas.sh --staged-only; then
        echo ""
        echo -e "${YELLOW}⚠ Tu touches à une zone protégée.${NC}"
        echo "Assure-toi d'avoir fait l'IMPACT_ANALYSIS et la double review (Claude + Codex)."
        echo ""
        read -p "Continuer le commit ? (y/N) " -n 1 -r < /dev/tty
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    fi
fi

echo -e "${GREEN}[pre-commit]${NC} ${GREEN}OK.${NC}"
exit 0
