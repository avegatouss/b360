  "B360 Migration additive (non-destructive)": {
    "scope": "php",
    "prefix": "b360-migration",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "use Illuminate\\\\Database\\\\Migrations\\\\Migration;",
      "use Illuminate\\\\Database\\\\Schema\\\\Blueprint;",
      "use Illuminate\\\\Support\\\\Facades\\\\Schema;",
      "",
      "/**",
      " * ${1:Description courte de l'évolution structurelle}.",
      " *",
      " * Type : additif (ne supprime ni ne renomme aucune colonne).",
      " * Réversible : oui — voir down().",
      " */",
      "return new class extends Migration {",
      "    public function up(): void",
      "    {",
      "        Schema::table('${2:table_name}', function (Blueprint \\$table) {",
      "            \\$table->${3:string}('${4:column_name}')->${5:nullable()}->after('${6:after_column}');",
      "            $0",
      "        });",
      "    }",
      "",
      "    public function down(): void",
      "    {",
      "        Schema::table('${2}', function (Blueprint \\$table) {",
      "            \\$table->dropColumn('${4}');",
      "        });",
      "    }",
      "};"
    ],
    "description": "Migration additive et réversible (B360 standard)"
  },
