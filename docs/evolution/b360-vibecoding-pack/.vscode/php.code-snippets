{
  "B360 Service skeleton": {
    "scope": "php",
    "prefix": "b360-service",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace Modules\\\\${1:Module}\\\\Services;",
      "",
      "use Illuminate\\\\Support\\\\Facades\\\\DB;",
      "use Illuminate\\\\Support\\\\Facades\\\\Log;",
      "",
      "/**",
      " * ${2:Service description}.",
      " *",
      " * @see docs/specs/${1/(.*)/${1:/downcase}/}.md",
      " */",
      "final class ${3:ServiceName}",
      "{",
      "    public function __construct(",
      "        // private readonly Dependency \\$dependency,",
      "    ) {",
      "    }",
      "",
      "    public function ${4:execute}(${5:array \\$payload}): ${6:mixed}",
      "    {",
      "        return DB::transaction(function () use (\\$payload) {",
      "            $0",
      "        });",
      "    }",
      "}"
    ],
    "description": "Service Layer B360 avec transaction + namespace module"
  },
  "B360 Action (single-use case)": {
    "scope": "php",
    "prefix": "b360-action",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace Modules\\\\${1:Module}\\\\Actions;",
      "",
      "use Illuminate\\\\Support\\\\Facades\\\\DB;",
      "",
      "final class ${2:ActionName}",
      "{",
      "    public function execute(${3:array \\$input}): ${4:mixed}",
      "    {",
      "        return DB::transaction(function () use (\\$input) {",
      "            $0",
      "        });",
      "    }",
      "}"
    ],
    "description": "Action use-case unique (1 méthode publique)"
  },
  "B360 Stock-safe update with lockForUpdate": {
    "scope": "php",
    "prefix": "b360-lock",
    "body": [
      "DB::transaction(function () use (\\$${1:productId}, \\$${2:quantity}) {",
      "    \\$stock = ${3:Stock}::where('product_id', \\$${1})->lockForUpdate()->firstOrFail();",
      "    if (\\$stock->quantity < \\$${2}) {",
      "        throw new \\\\Modules\\\\${4:Module}\\\\Exceptions\\\\InsufficientStockException(",
      "            \"Stock insuffisant pour produit {\\$${1}}\"",
      "        );",
      "    }",
      "    \\$stock->decrement('quantity', \\$${2});",
      "    $0",
      "});"
    ],
    "description": "Lecture + décrément stock protégé par lockForUpdate (anti race condition)"
  },
