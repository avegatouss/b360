#!/usr/bin/env bash
# .git/hooks/post-commit
# Rappel non bloquant : suggère d'actualiser la mémoire si une zone protégée a été touchée.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Fichiers du dernier commit
CHANGED_IN_COMMIT=$(git diff-tree --no-commit-id --name-only -r HEAD)

# Patterns de zones protégées (cf docs/governance/PROTECTED_AREAS.md)
PROTECTED_PATTERNS=(
    "Modules/Auth"
    "Modules/Core/Database/Traits/BelongsToInstance"
    "Modules/Core/Services/InstanceManager"
    "Modules/Core/Services/InstanceResolver"
    "Modules/Users/Services/Role"
    "Modules/Eshop360/Services/StockService"
    "Modules/Eshop360/Services/Pricing"
    "Modules/Eshop360/Services/CashRegister"
    "Modules/Billing/Services"
    "Modules/Billing/Webhooks"
    "Modules/Core/Models/AuditLog"
    "app/Models/User.php"
    "app/Instances"
)

TOUCHED_PROTECTED=()
for pattern in "${PROTECTED_PATTERNS[@]}"; do
    if echo "$CHANGED_IN_COMMIT" | grep -q "$pattern"; then
        TOUCHED_PROTECTED+=("$pattern")
    fi
done

if [ ${#TOUCHED_PROTECTED[@]} -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}╔════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  ⚠  Tu viens de toucher des zones protégées                    ║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    for area in "${TOUCHED_PROTECTED[@]}"; do
        echo -e "  ${YELLOW}•${NC} $area"
    done
    echo ""
    echo "Penses à mettre à jour AVANT de pusher :"
    echo -e "  ${BLUE}1.${NC} docs/memory/CURRENT_STATE.md (si état du module change)"
    echo -e "  ${BLUE}2.${NC} docs/memory/RECENT_DECISIONS.md (si décision structurante)"
    echo -e "  ${BLUE}3.${NC} CHANGELOG_ARCHITECTURAL.md (si changement architectural)"
    echo -e "  ${BLUE}4.${NC} docs/index/ (si nouvelle permission, événement, API, table)"
    echo ""
    echo "Commande rapide :"
    echo -e "  ${GREEN}make memory-refresh${NC}"
    echo ""
fi

# Régénération auto des index si schéma DB touché
if echo "$CHANGED_IN_COMMIT" | grep -qE 'database/migrations/|Modules/.*/Database/Migrations/'; then
    echo -e "${BLUE}[post-commit]${NC} Migrations modifiées détectées."
    echo -e "${BLUE}[post-commit]${NC} Pense à régénérer l'index DB : ${GREEN}make audit-db${NC}"
fi

# Régénération auto des index permissions
if echo "$CHANGED_IN_COMMIT" | grep -qE 'PermissionGroup|permissions\.php|HookRegistry.*permission'; then
    echo -e "${BLUE}[post-commit]${NC} Permissions modifiées détectées."
    echo -e "${BLUE}[post-commit]${NC} Pense à régénérer : ${GREEN}make audit-permissions${NC}"
fi

exit 0
